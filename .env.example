# =============================================================
# LOCAL DEVELOPMENT (Supabase CLI — `npm run db:start`)
# Uses custom ports (54332) to avoid conflicts with other projects.
# Default password for local Supabase is "postgres".
# =============================================================
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"

# =============================================================
# PRODUCTION / HOSTED SUPABASE (uncomment and fill in for deploy)
# Get these from: Supabase Dashboard > Project Settings > Database
# =============================================================
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
